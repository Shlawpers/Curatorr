# Curatorr Configuration
# Copy to .env and fill in your values

# Required - Your Plex server
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your_plex_token_here

# Optional - Kometa integration (for schedule conflict detection)
# KOMETA_CONFIG_PATH=/path/to/kometa/config

# Optional - App settings
APPLY_MODE=dry-run   # dry-run = read-only, apply = allow changes
PORT=3000
TZ=UTC

# Optional - Authentication (disabled by default)
# CURATORR_AUTH_ENABLED=true
# CURATORR_AUTH_PASSWORD=your-password-here
# CURATORR_SESSION_SECRET=random-string-for-cookie-signing
